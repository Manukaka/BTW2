# Beyond Tourism World CRM — backend environment variables
#
# This file only lists the NAMES. Copy it to `.env` for local testing with `netlify dev`
# (`.env` is git-ignored), and on the live site add the same names under
# Netlify → Site configuration → Environment variables, then trigger a deploy.
#
# Pick ONE AI provider:
ANTHROPIC_API_KEY=            # sk-ant-...   from console.anthropic.com → API Keys
# GEMINI_API_KEY=             # AIza...      from aistudio.google.com (free tier)

# Optional model overrides (leave unset for the recommended defaults)
# ANTHROPIC_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-2.0-flash

# Any long random text. Paste the same text in CRM → Settings → Team backend → access code.
CRM_ACCESS_CODE=

# Optional — WhatsApp Cloud API automatic sending
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Optional — lets signed-in team members call the backend without the access code
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
